-- ツリーのノード。kind は 0=グループ 1=チャンネル。parent_id が NULL のノードが最上位。
CREATE TABLE node (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    parent_id INTEGER REFERENCES node(id) ON DELETE CASCADE,
    position INTEGER NOT NULL,
    kind INTEGER NOT NULL,
    name TEXT NOT NULL
);

CREATE INDEX node_parent ON node(parent_id, position);

-- チャンネルの付帯情報。node と 1 対 1。
-- first_fetch_as_read が 1 のチャンネルは、次に取得に成功したとき、得た記事を既読として登録する。
CREATE TABLE channel (
    node_id INTEGER PRIMARY KEY REFERENCES node(id) ON DELETE CASCADE,
    feed_url TEXT NOT NULL,
    site_url TEXT,
    title TEXT,
    paused INTEGER NOT NULL DEFAULT 0,
    first_fetch_as_read INTEGER NOT NULL DEFAULT 0,
    etag TEXT,
    last_modified TEXT,
    fetched_at INTEGER,
    error_kind INTEGER NOT NULL DEFAULT 0,
    error_detail TEXT,
    gone_count INTEGER NOT NULL DEFAULT 0,
    gone_at INTEGER
);

-- 記事。state は 0=未読 1=既読 2=保護。時刻は UTC のエポックミリ秒。
CREATE TABLE article (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    channel_id INTEGER NOT NULL REFERENCES channel(node_id) ON DELETE CASCADE,
    identity TEXT NOT NULL,
    title TEXT NOT NULL,
    link TEXT,
    summary TEXT,
    content TEXT,
    author TEXT,
    category TEXT,
    published_at INTEGER,
    sort_at INTEGER NOT NULL,
    state INTEGER NOT NULL DEFAULT 0,
    UNIQUE (channel_id, identity)
);

CREATE INDEX article_channel_sort ON article(channel_id, sort_at);

-- 整理・削除した記事の識別子。フィードに残っている記事が新着として戻るのを防ぐ。
CREATE TABLE seen (
    channel_id INTEGER NOT NULL REFERENCES channel(node_id) ON DELETE CASCADE,
    identity TEXT NOT NULL,
    seen_at INTEGER NOT NULL,
    PRIMARY KEY (channel_id, identity)
);

CREATE TABLE setting (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

selectNodes:
SELECT node.id, node.parent_id, node.position, node.kind, node.name,
       channel.feed_url, channel.site_url, channel.title, channel.paused, channel.error_kind
FROM node
LEFT JOIN channel ON channel.node_id = node.id
ORDER BY node.parent_id, node.position;

countNodes:
SELECT COUNT(*) FROM node;

insertNode:
INSERT INTO node (parent_id, position, kind, name)
VALUES (?, ?, ?, ?);

insertChannel:
INSERT INTO channel (node_id, feed_url, site_url, title, paused, first_fetch_as_read)
VALUES (?, ?, ?, ?, ?, ?);

-- 同じ親の下の末尾に置くときの position。
selectNextPosition:
SELECT coalesce(max(position), -1) + 1 FROM node WHERE parent_id IS ?;

-- 購読を再開するときに数え直せるよう、フィードが無くなったことを示す応答の記録も消す。
setChannelsPaused:
UPDATE channel SET paused = ?, gone_count = 0, gone_at = NULL WHERE node_id IN ?;

updateNodeName:
UPDATE node SET name = ? WHERE id = ?;

-- 配下のノード、チャンネルの情報、記事は、外部キーの指定で一緒に消える。
deleteNode:
DELETE FROM node WHERE id = ?;

-- 前の URL で得た条件付き取得の値は、新しい URL には使えないので消す。
updateFeedUrl:
UPDATE channel SET feed_url = ?, etag = NULL, last_modified = NULL WHERE node_id = ?;

selectChildren:
SELECT id, name FROM node WHERE parent_id IS ? ORDER BY position, id;

updateNodePlace:
UPDATE node SET parent_id = ?, position = ? WHERE id = ?;

lastInsertRowId:
SELECT last_insert_rowid();

insertArticle:
INSERT OR IGNORE INTO article
    (channel_id, identity, title, link, summary, content, author, category, published_at, sort_at, state)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

selectArticleRows:
SELECT id, channel_id, title, link, author, category, published_at, sort_at, state
FROM article;

selectArticleRowsByChannels:
SELECT id, channel_id, title, link, author, category, published_at, sort_at, state
FROM article
WHERE channel_id IN ?;

selectSetting:
SELECT value FROM setting WHERE key = ?;

selectSettings:
SELECT key, value FROM setting;

upsertSetting:
INSERT OR REPLACE INTO setting (key, value) VALUES (?, ?);

selectArticleBody:
SELECT summary, content, link FROM article WHERE id = ?;

selectArticleCounts:
SELECT channel_id, COUNT(*) AS total, SUM(state = 0) AS unread
FROM article
GROUP BY channel_id;

selectUpdateTargets:
SELECT node_id, feed_url, etag, last_modified, first_fetch_as_read, gone_count, gone_at
FROM channel
WHERE paused = 0;

recordFetchSuccess:
UPDATE channel
SET feed_url = ?,
    site_url = coalesce(?, site_url),
    title = coalesce(?, title),
    etag = ?,
    last_modified = ?,
    fetched_at = ?,
    first_fetch_as_read = 0,
    error_kind = 0,
    error_detail = NULL,
    gone_count = 0,
    gone_at = NULL
WHERE node_id = ?;

recordNotModified:
UPDATE channel
SET feed_url = ?,
    fetched_at = ?,
    error_kind = 0,
    error_detail = NULL,
    gone_count = 0,
    gone_at = NULL
WHERE node_id = ?;

recordFetchFailure:
UPDATE channel
SET fetched_at = ?,
    error_kind = ?,
    error_detail = ?,
    gone_count = ?,
    gone_at = ?,
    paused = ?
WHERE node_id = ?;

selectArticleIdentities:
SELECT identity FROM article WHERE channel_id = ?;

selectSeenIdentities:
SELECT identity FROM seen WHERE channel_id = ?;

touchSeen:
UPDATE seen SET seen_at = ? WHERE channel_id = ? AND identity = ?;

updateArticleContent:
UPDATE article
SET title = ?, link = ?, summary = ?, content = ?, author = ?, category = ?, published_at = ?
WHERE channel_id = ? AND identity = ?;

updateArticleState:
UPDATE article SET state = ? WHERE id = ?;

rememberDeletedArticle:
INSERT OR REPLACE INTO seen (channel_id, identity, seen_at)
SELECT channel_id, identity, ? FROM article WHERE id = ?;

deleteArticle:
DELETE FROM article WHERE id = ?;

-- 既読の記事のうち、指定の時刻より古いものと、新しい方から数えて保存数を超えたもの。
selectExpiredArticleIds:
SELECT id FROM article
WHERE channel_id = :channelId AND state = 1
  AND (sort_at < :oldestSortAt
       OR id NOT IN (
           SELECT id FROM article
           WHERE channel_id = :channelId AND state = 1
           ORDER BY sort_at DESC, id DESC
           LIMIT :keepCount
       ));

deleteStaleSeen:
DELETE FROM seen WHERE channel_id = ? AND seen_at < ?;
